{
  "description": "Run DuckDB SQLLogicTests against the on-disk SlateDB-backed filesystem.",
  "extends": [
    "skip/extension_bugs.json",
    "skip/unsupported_features.json",
    "skip/by_design.json"
  ],
  "on_init": "SET duckdb_objfs_backend = 'local'; SET duckdb_objfs_root = '__TEST_DIR___slatedb/{BASE_TEST_NAME}'; PRAGMA duckdb_objfs_attach_mapped_database('__test__config__slatedb');",
  "on_new_connection": "USE __test__config__slatedb;",
  "skip_compiled": true,
  "statically_loaded_extensions": [
    "core_functions",
    "duckdb_object_storage"
  ]
}
