# name: test/sql/duckdb_object_storage.test
# description: test duckdb_object_storage extension
# group: [sql]

require duckdb_object_storage

# SlateDB VFS is registered and claims duckdb_objfs:// paths
statement error
SELECT * FROM glob('duckdb_objfs://dummy/**');
----
SlateDBFileSystem::Glob is not implemented

# Production initialization requires explicit object-storage configuration.
statement error
ATTACH 'duckdb_objfs://integration.db' AS object_db
----
Required setting 'duckdb_objfs_bucket' is not configured

# Local integration coverage persists SlateDB data under the test directory.
statement ok
SET duckdb_objfs_backend = 'local'

statement ok
SET duckdb_objfs_local_path = '__TEST_DIR__/duckdb_objfs_local'

statement ok
ATTACH 'duckdb_objfs://integration.db' AS object_db

statement ok
CREATE TABLE object_db.items(i INTEGER)

statement ok
INSERT INTO object_db.items VALUES (1), (2)

statement ok
CHECKPOINT object_db

query I
SELECT sum(i) FROM object_db.items
----
3

statement ok
DETACH object_db

statement ok
ATTACH 'duckdb_objfs://integration.db' AS object_db (READ_ONLY)

query I
SELECT sum(i) FROM object_db.items
----
3

statement ok
DETACH object_db
