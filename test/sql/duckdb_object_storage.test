# name: test/sql/duckdb_object_storage.test
# description: test duckdb_object_storage extension
# group: [sql]

# Before we load the extension, this will fail
statement error
SELECT duckdb_object_storage('Sam');
----
Catalog Error: Scalar Function with name duckdb_object_storage does not exist!

# Require statement will ensure this test is run with this extension loaded
require duckdb_object_storage

# Confirm the extension works
query I
SELECT duckdb_object_storage('Sam');
----
DuckdbObjectStorage Sam 🐥

query I
SELECT duckdb_object_storage_openssl_version('Michael') ILIKE 'DuckdbObjectStorage Michael, my linked OpenSSL version is OpenSSL%';
----
true

# SlateDB VFS is registered and claims duckdb_objfs:// paths
statement error
SELECT * FROM glob('duckdb_objfs://dummy/**');
----
SlateDBFileSystem::Glob is not implemented

# DuckDB can create, checkpoint, detach, and reopen a database through SlateDB
statement ok
ATTACH 'duckdb_objfs://integration.db' AS object_db

statement ok
CREATE TABLE object_db.items(i INTEGER)

statement ok
INSERT INTO object_db.items VALUES (1), (2)

statement ok
CHECKPOINT object_db

query I
SELECT sum(i) FROM object_db.items
----
3

statement ok
DETACH object_db

statement ok
ATTACH 'duckdb_objfs://integration.db' AS object_db

query I
SELECT sum(i) FROM object_db.items
----
3

statement ok
DETACH object_db
